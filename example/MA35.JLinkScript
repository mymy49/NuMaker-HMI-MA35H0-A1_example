/*********************************************************************
*
*       ConfigTargetSettings
*
*  Function description
*    Called before the connection. Can set global DLL variables.
*/
void ConfigTargetSettings(void) {
    // 디버그는 코어(APB-AP, 포트 1)로, 메모리 다운로드는 버스(AHB-AP, 포트 2)로 직접 수행하도록 강제 지정
    JLINK_ExecCommand("Device = CORTEX-A35");
    // JLINK_CORESIGHT_IndexAHBAPToUse = 2; 
    JLINK_CORESIGHT_IndexAPBAPToUse = 1; 
}

/*********************************************************************
*
*       InitTarget
*
*  Function description
*    Called before any connection to the target is performed.
*/
void InitTarget(void) {
    JLINK_SYS_Report("MA35 InitTarget: Starting...");
}

/*********************************************************************
*
*       SetupTarget
*
*  Function description
*    Called right after a connection to the target has been established.
*/
void SetupTarget(void) {
    JLINK_SYS_Report("MA35 SetupTarget: NuWriter already initialized the board.");
}

/*********************************************************************
*
*       ResetTarget
*
*  Function description
*    Custom reset sequence if the default one fails.
*/
void ResetTarget(void) 
{
    // Halt Core
    JLINK_MEM_WriteU32(0xE0C10090, 0x00000001); // DBGDRCR Halt Request

	// Core Warm Reset Request(Unknown if it operates normally)
	JLINK_MEM_WriteU32(0xE0C10310, 0x2);
	
	// Unlock
    JLINK_MEM_WriteU32(0x404601A0, 0x00000059);
    JLINK_MEM_WriteU32(0x404601A0, 0x00000016);
    JLINK_MEM_WriteU32(0x404601A0, 0x00000088);

    JLINK_MEM_WriteU32(0x404601A4, 0x00000059);
    JLINK_MEM_WriteU32(0x404601A4, 0x00000016);
    JLINK_MEM_WriteU32(0x404601A4, 0x00000088);

	// Set Reset
	JLINK_MEM_WriteU32(0x40460020, 0x00000000);
    JLINK_MEM_WriteU32(0x40460024, 0x0000003C);
    JLINK_MEM_WriteU32(0x40460028, 0x00000000);
    JLINK_MEM_WriteU32(0x4046002C, 0x000000FF);
    JLINK_SYS_Sleep(10);
    
    // Clear Reset
	JLINK_MEM_WriteU32(0x40460020, 0x00000000);
    JLINK_MEM_WriteU32(0x40460024, 0x00000000);
    JLINK_MEM_WriteU32(0x40460028, 0x00000000);
    JLINK_MEM_WriteU32(0x4046002C, 0x00000000);
    JLINK_SYS_Sleep(10);
    
	// Lock
    JLINK_MEM_WriteU32(0x404601A0, 0x00000000);
    JLINK_MEM_WriteU32(0x404601A4, 0x00000000);
}
